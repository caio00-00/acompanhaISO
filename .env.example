# A página NÃO precisa de nenhuma variável: a conexão com o Supabase fica em public/config.js
# (URL + publishable key, que podem ir para o GitHub).
#
# As variáveis abaixo só são necessárias para os E-MAILS automáticos, porque levam a senha
# da conta de e-mail — cadastre-as na Vercel (Settings → Environment Variables), nunca no Git.

# Segredo do agendamento (texto longo e aleatório). O mesmo vai no supabase/04_agendamento.sql
CRON_SECRET=troque-por-um-texto-aleatorio-longo

# Conta que envia os e-mails
# Gmail / Google Workspace: smtp.gmail.com, porta 465, senha de app
# Microsoft 365: smtp.office365.com, porta 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=planodeacao@oroseducacao.com.br
SMTP_PASS=senha-de-app

# Opcional: endereço usado no botão "Abrir minhas atividades" dos e-mails
# SITE_URL=https://seu-site.vercel.app
