# Copie para .env só se for rodar no seu computador (npm run dev).
# Na Vercel, cadastre estes mesmos nomes em Settings → Environment Variables.

# Supabase → botão "Connect" → "Transaction pooler" (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Senha que a equipe digita para entrar no site
ACESSO_SENHA=troque-por-uma-senha-forte

# Segredo do agendamento (qualquer texto longo e aleatório). O mesmo vai no 03_agendamento.sql
CRON_SECRET=troque-por-um-texto-aleatorio-longo

# Conta que envia os e-mails
# Gmail / Google Workspace: smtp.gmail.com, porta 465, senha de app
# Microsoft 365: smtp.office365.com, porta 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=planodeacao@oroseducacao.com.br
SMTP_PASS=senha-de-app

# Opcional: endereço usado no botão "Abrir minhas atividades" dos e-mails
# (se vazio, usa o domínio de produção da Vercel)
SITE_URL=

# Só para teste local com Postgres sem SSL
# DATABASE_SSL=false
